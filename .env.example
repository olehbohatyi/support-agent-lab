# Copy to .env and fill in. Never commit .env.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (docker compose reads the same values)
POSTGRES_DB=support_agent_lab
POSTGRES_USER=support_agent_lab
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# LLM providers (B-03). Leave empty to run on FakeProvider only.
ANTHROPIC_API_KEY=

LOG_LEVEL=INFO
